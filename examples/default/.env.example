# Application Configuration
APP_PORT=3200
APP_URL=http://localhost:3200

# User/Group ID mapping for filesystem permissions
# The container will run with these UID/GID to match your host user
# This ensures proper file permissions on mounted volumes
# On Linux/macOS, get your UID/GID with: id -u and id -g
UID=1000
GID=1000

# Worker Configuration (for gardarr-worker service)
WORKER_PORT=3100
WORKER_SECRET=your-secret-key-here

# qBittorrent Configuration
QBITTORRENT_BASEURL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminpass
