# Application Configuration
APP_PORT=3200
APP_URL=http://localhost:3200

# Required to encrypt stored worker credentials.
# Generate a unique value with: openssl rand -base64 32
# ENCRYPTION_KEY=

# User/Group ID mapping for filesystem permissions
# The container will run with these UID/GID to match your host user
# This ensures proper file permissions on mounted volumes
# On Linux/macOS, get your UID/GID with: id -u and id -g
UID=1000
GID=1000

# Add qBittorrent instances after signing in: Settings → Workers.
