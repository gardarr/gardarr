    "about": {
      "title": "Sobre",
      "subtitle": "Informações sobre o projeto Gardarr",
      "tagline": "Ferramenta de código aberto, leve e otimizada para gerenciamento e análise do qBittorrent",
      "version": "Versão",
      "description": {
        "title": "Sobre o Projeto",
        "text1": "Gardarr é uma ferramenta moderna e leve de gerenciamento e análise projetada especificamente para qBittorrent. Construído com foco na otimização para dispositivos móveis, oferece uma interface intuitiva para monitorar e gerenciar seus torrents de qualquer dispositivo.",
        "text2": "O projeto é open-source e orientado pela comunidade, priorizando código limpo e de fácil manutenção que pode ser auto-hospedado por qualquer pessoa. Seja gerenciando uma única instância ou múltiplos agentes, o Gardarr oferece as ferramentas que você precisa em uma interface bonita e responsiva."
      },
      "features": {
        "title": "Recursos Principais",
        "multiPlatform": "Suporte multiplataforma com imagens Docker para AMD64 e ARM64",
        "automated": "Pipeline automatizado de CI/CD com GitHub Actions",
        "lightweight": "Leve e otimizado para desempenho",
        "openSource": "Código aberto com licença GPL-3.0",
        "mobileOptimized": "Design mobile-first com interface responsiva"
      },
