# Gardarr - Environment Variables Example
# Copy this file to .env and adjust the values as needed

# =============================================================================
# APPLICATION
# =============================================================================
APP_PORT=3200
APP_MODE=standalone  # standalone | service
APP_URL=http://localhost:3200

# =============================================================================
# DATABASE
# =============================================================================
# Full path to the SQLite database file
# This directory will be validated at startup and created if it doesn't exist
DATABASE_FILE_PATH=/data/gardarr_database.db

# =============================================================================
# AGENTS
# =============================================================================
AGENT_SECRET=your-secret-key-here
AGENT_PORT=3100

# =============================================================================
# STATISTICS
# =============================================================================
STATISTICS_ENABLED=true
STATISTICS_INTERVAL=30s
# Directory where statistics files will be stored
# This directory will be validated at startup and created if it doesn't exist
STATISTICS_DIR=/data/statistics
STATISTICS_RETENTION_DAYS=7
STATISTICS_PURGE_INTERVAL=30m

# =============================================================================
# EVENTS (Change Tracking System)
# =============================================================================
# Days to keep events in the database
# - Default: 30 days
# - 0 = no limit (keep indefinitely)
# - Recommended dev: 7 days
# - Recommended prod: 30-90 days
EVENT_RETENTION_DAYS=30

# =============================================================================
# SECURITY
# =============================================================================
# JWT_SECRET=your-jwt-secret-here
# SESSION_SECRET=your-session-secret-here

# =============================================================================
# IMAGE UPLOAD
# =============================================================================
# Directory where torrent images will be stored
# This directory will be validated at startup and created if it doesn't exist
TORRENT_IMAGE_UPLOAD_DIR=/media/uploads/images

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# CUSTOM_CSP=default-src 'self'

# Application log level
# - debug: Shows detailed GIN and application logs (debug mode)
# - info: Informational logs (default, GIN release mode)
# - warn: Warnings and errors only
# - error: Errors only
LOG_LEVEL=info
